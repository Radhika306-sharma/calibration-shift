from itertools import permutations
from math import factorial
def exact_spearman_p(x, y):
    rho = spearmanr(x, y).statistic
    hits = sum(abs(spearmanr(x, np.array(y)[list(perm)]).statistic) >= abs(rho) - 1e-12
               for perm in permutations(range(len(x))))
    return rho, hits / factorial(len(x))

rows = []
for m in MODELS:
    s = results_df[results_df.model == m]
    rho, p_exact = exact_spearman_p(s.PSI.values, s.ece.values)
    rows.append({"model": m, "spearman_rho": round(rho, 3), "exact_p_value": round(p_exact, 4)})
pd.DataFrame(rows)


